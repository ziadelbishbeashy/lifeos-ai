# LifeOS Foundation V2 — local development
LIFEOS_ENV=development
SECRET_KEY=replace-with-a-long-random-development-secret

# Preferred: local PostgreSQL or Neon.
DATABASE_URL=postgresql://lifeos:lifeos@127.0.0.1:5432/lifeos
# Neon: use a direct, non-pooler URL for migration/admin operations.
DATABASE_DIRECT_URL=

# Temporary migration escape hatch only. New development should stay on Postgres.
DB_BACKEND=postgresql
REQUIRE_POSTGRES_IN_PRODUCTION=true

AUTO_CREATE_DB=true
FLASK_DEBUG=true
COOKIE_SECURE=false
MAX_UPLOAD_SIZE_MB=25

# Step 20 — Limits & Cost Controls
# Keep these conservative until real usage data justifies increasing them.
MAX_PDF_PAGES=300
MAX_EXTRACTED_TEXT_CHARACTERS=200000
MAX_CHUNKS_PER_DOCUMENT=250
MAX_SCOPE_DOCUMENTS=50
MAX_RETRIEVAL_RESULTS=12
MAX_RAG_CONTEXT_CHARACTERS=20000
MAX_AI_PROMPT_CHARACTERS=120000
AI_MAX_GENERATION_CALLS_PER_REQUEST=4
MAX_EMBEDDING_BATCH_SIZE=50
AI_MAX_EMBEDDING_CALLS_PER_REQUEST=12
AI_MAX_EMBEDDING_CHARACTERS_PER_REQUEST=120000

STORAGE_BACKEND=local
JOB_BACKEND=inline
PUBLIC_BASE_URL=http://127.0.0.1:5000

# AI provider secrets stay in backend env only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=

# AI usage + profitability telemetry
# Exact provider token counts are stored without prompt/output content.
AI_USAGE_LEDGER_ENABLED=true
# Optional per-model pricing overrides (USD per 1M tokens). Built-in Gemini
# 2.5 Flash values are a 2026-09-06 snapshot and should be reviewed at deploy.
AI_PRICE_GEMINI_GEMINI_2_5_FLASH_INPUT_PER_MILLION_USD=0.30
AI_PRICE_GEMINI_GEMINI_2_5_FLASH_CACHED_INPUT_PER_MILLION_USD=0.03
AI_PRICE_GEMINI_GEMINI_2_5_FLASH_OUTPUT_PER_MILLION_USD=2.50

# Document Brain embedding model/cost telemetry.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
AI_PRICE_GEMINI_GEMINI_EMBEDDING_2_INPUT_PER_MILLION_USD=0.20
AI_PRICE_GEMINI_GEMINI_EMBEDDING_2_CACHED_INPUT_PER_MILLION_USD=0.20
AI_PRICE_GEMINI_GEMINI_EMBEDDING_2_OUTPUT_PER_MILLION_USD=0.00

# Optional LangSmith tracing. LifeOS accounting does not depend on LangSmith.
# Traces contain model/feature/token/cost metadata but not prompt/output content.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lifeos-development

# Step 15 OCR (scanned / mixed PDFs)
# Requires the Tesseract executable plus the requested language packs.
OCR_PROVIDER=disabled
OCR_LANGUAGES=eng
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TESSERACT_CMD=
OCR_RENDER_DPI=300
OCR_LOW_CONFIDENCE_THRESHOLD=0.70
OCR_AUTO_ENQUEUE=false
OCR_PREPROCESSING_ENABLED=false
OCR_PREPROCESSING_MODE=auto

# Adaptive OCR quality fallback
OCR_TESSERACT_PSM_MODES=3,6,11
OCR_EASYOCR_ENABLED=false
OCR_EASYOCR_LANGUAGES=en
OCR_EASYOCR_GPU=false
OCR_EASYOCR_MODEL_DIR=
OCR_EASYOCR_DOWNLOAD_ENABLED=true

# I17 Automations V1 preparation
# Keep disabled until the I17 activation gate is explicitly completed.
# I17 background intelligence worker. Keep false unless a dedicated worker process is running.
ENABLE_LIFEOS_AUTOMATIONS=false
LIFEOS_AUTOMATION_POLL_SECONDS=60
LIFEOS_DEFAULT_TIMEZONE=UTC
